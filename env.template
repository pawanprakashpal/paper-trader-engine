# Copy to .env for local runs (never commit .env). In GitHub, the same names are repository secrets.
# --- NSE data: Angel One SmartAPI (a Historical Data app's API key; this engine never places orders)
ANGEL_HIST_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# --- US data: Alpaca (paper account keys work for market data)
ALPACA_KEY_ID=
ALPACA_SECRET=
# --- Alerts: Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Live page: FTPS upload of live-<market>.json (e.g. a cPanel FTP account limited to one folder)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_DIR=
# --- Position sizing (optional; defaults are in backtest_intraday.MKT)
CAPITAL_INDIA=
PER_TRADE_INDIA=
MAX_TRADES_INDIA=
CAPITAL_US=
PER_TRADE_US=
MAX_TRADES_US=
